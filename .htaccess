# Sécurité : masquer l'architecture, interdire l'exploration
Options -Indexes
ServerSignature Off
# ServerTokens Prod doit être dans httpd.conf (pas possible ici)
<IfModule mod_headers.c>
    Header unset Server
    Header always unset Server
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Redirection Front Controller : /login, /dashboard, /employes, /empreintes, etc. → frontend/
RewriteEngine On
RewriteBase /projet_Stage_MADA-Digital/

# Ne pas réécrire les fichiers existants (assets, api, uploads)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routes amicales
RewriteRule ^$ frontend/login.php [L]
RewriteRule ^login/?$ frontend/login.php [L]
RewriteRule ^dashboard/?$ frontend/dashboard.php [L]
RewriteRule ^employes/?$ frontend/employes.php [L]
RewriteRule ^empreintes/?$ frontend/empreintes.php [L]
RewriteRule ^administrateurs/?$ frontend/administrateurs.php [L]
RewriteRule ^historique/?$ frontend/historique.php [L]
RewriteRule ^pointage/?$ frontend/pointage.php [L]
RewriteRule ^parametres/?$ frontend/parametres.php [L]

# Bloquer l'accès direct aux fichiers sensibles
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "^(config|\.env|composer|\.git|schema)">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|example|log|sql|ini|json|lock)$">
    Require all denied
</FilesMatch>

# Headers de sécurité (expr=-z : ne pose que si PHP ne l'a pas déjà mis → pas de doublons API)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" "expr=-z %{resp:X-Content-Type-Options}"
    Header always set X-Frame-Options "DENY" "expr=-z %{resp:X-Frame-Options}"
    Header always set Referrer-Policy "strict-origin-when-cross-origin" "expr=-z %{resp:Referrer-Policy}"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" "expr=-z %{resp:Content-Security-Policy}"
    # M1 : n'ajoute chaque attribut que s'il est ABSENT (évite le doublon
    # SameSite=Lax qui écraserait le SameSite=None; Secure posé en HTTPS par PHP)
    Header always edit Set-Cookie ^((?:(?!HttpOnly).)*)$ "$1;HttpOnly"
    Header always edit Set-Cookie ^((?:(?!SameSite).)*)$ "$1;SameSite=Lax"
</IfModule>
