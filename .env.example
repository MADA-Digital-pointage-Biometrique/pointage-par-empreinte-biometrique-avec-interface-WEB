# ============================================================
# MADA Digital — Variables d'environnement (TEMPLATE)
# ============================================================
# Copiez ce fichier en .env et renseignez vos valeurs.

# ── Base de données (Supabase PostgreSQL) ──
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=require

# ── Chiffrement RGPD Art.9 des gabarits biométriques (AES-256-GCM) ──
# Générez avec : php -r "echo bin2hex(random_bytes(32));"
# Une fois fixée, NE JAMAIS CHANGER : les gabarits enregistrés deviennent illisibles.
APP_ENCRYPTION_KEY=

# ── Borne biométrique ──
BORNE_TOKEN=

# ── Cron archivage ──
CRON_SECRET=

# ── Capteur Biométrique (Microcontrôleur HTTP / WS) ──
R307_PASSWORD=00000000
R307_TIMEOUT=15
R307_PORT=auto
R307_BAUD=57600
R307_PYTHON_PATH=python

# ── Surveillance capteur (daemon r307_service.py) ──
# URL du daemon local (propriétaire du port COM). SdkReader le consulte en priorité.
R307_SERVICE_URL=http://127.0.0.1:8765
# URL complète de l'API borne, appelée par le daemon à chaque doigt détecté.
# Doit être joignable depuis le PC serveur (ex. http://localhost/projet_Stage_MADA-Digital/api/borne_pointage.php)
R307_API_URL=

# ── Seed admin (optionnel : sinon mot de passe généré affiché une fois) ──
# SEED_ADMIN_PASSWORD=
