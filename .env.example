# ============================================================
# MADA Digital — Variables d'environnement (TEMPLATE)
# ============================================================
# Copiez ce fichier en .env et renseignez vos valeurs.

# ── Base de données (Supabase PostgreSQL) ──
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=require

# ── Borne biométrique ──
BORNE_TOKEN=

# ── Cron archivage ──
CRON_SECRET=

# ── Dispositif biométrique (HTTP / Wi-Fi, générique — aucun pilote local) ──
# URL de base du dispositif (ex. http://192.168.1.50). Vide = dispositif HS.
DEVICE_BASE_URL=
# Préfixe des routes côté firmware (défaut /api).
DEVICE_API_PREFIX=/api
# Jeton Bearer optionnel envoyé au dispositif.
DEVICE_TOKEN=
# Attente doigt / captures (secondes).
DEVICE_TIMEOUT=15
# Requêtes rapides : état, comptage, sonde (secondes).
DEVICE_QUICK_TIMEOUT=4
# Score minimal 0..100 pour accepter un pointage.
DEVICE_THRESHOLD=60
# Identifiant logique (colonne biometric_slots.device_id).
DEVICE_ID=device_main

# ── Seed admin (optionnel : sinon mot de passe généré affiché une fois) ──
# SEED_ADMIN_PASSWORD=

