# ============================================================
# MADA Digital — Variables d'environnement (TEMPLATE)
# ============================================================
# Copiez ce fichier en .env et renseignez vos valeurs.

# ── Base de données (Supabase PostgreSQL) ──
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=require

# ── Borne biométrique ──
BORNE_TOKEN=

# ── Cron archivage ──
CRON_SECRET=

# ── Capteur Biométrique (Microcontrôleur HTTP / WS) ──
R307_PASSWORD=00000000
R307_PORT=auto
R307_BAUD=57600
R307_PYTHON_PATH=python

# ── Seed admin (optionnel : sinon mot de passe généré affiché une fois) ──
# SEED_ADMIN_PASSWORD=

