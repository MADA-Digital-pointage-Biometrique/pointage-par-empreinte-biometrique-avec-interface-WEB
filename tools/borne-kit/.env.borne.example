# Kit borne MADA Digital — .env MINIMAL (2 vraies variables + 1 optionnelle)
# Copiez ce fichier en ".env" (sans extension) à côté de start_borne.bat
# et renseignez les 2 valeurs ci-dessous.

# Jeton borne : DOIT être identique au BORNE_TOKEN du serveur
# (le .env du serveur : projet_Stage_MADA-Digital/.env, ou Environment Dokploy).
BORNE_TOKEN=CHANGEZ-MOI-mettre-le-meme-que-le-serveur

# URL complète de l'API borne du serveur (test locale par défaut).
R307_API_URL=http://localhost:8080/api/borne_pointage.php

# Mot de passe du capteur R307 (défaut usine : 8 zéros). Ne touchez que si
# vous l'avez changé sur le capteur.
R307_PASSWORD=00000000
